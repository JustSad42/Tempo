<Window x:Class="Tempo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo" Width="560" Height="760" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#16171B"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Fg}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="4,22,0,8"/>
        </Style>
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,12"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="PlaceTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Width="30" Height="18">
                            <Border x:Name="Bar" CornerRadius="3" Background="#33FFFFFF" Width="22" Height="7"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#33FFFFFF"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="28,24,24,28" MaxWidth="640">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Tempo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tempo" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Faint}" FontSize="12" Margin="1,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Welcome / how it works -->
            <Border x:Name="Welcome" Style="{StaticResource CardBox}" Margin="0,20,0,0" Padding="16,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#268AA2FF" Offset="0"/>
                        <GradientStop Color="#0A8AA2FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Tempo now handles your media keys" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="19">
                        It runs hidden, with no tray icon. Press a media key and a pop-up shows briefly; it controls the app that's actually playing. Right-click the pop-up for more.
                        <LineBreak/>Hold <Run FontWeight="SemiBold" Foreground="{StaticResource Fg}">Next / Previous</Run> to scrub, and hold <Run FontWeight="SemiBold" Foreground="{StaticResource Fg}">Play/Pause</Run> to switch apps.
                        <LineBreak/>Open Tempo from the Start menu to get back here.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Live status -->
            <Border Style="{StaticResource CardBox}" Margin="0,12,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="9" Background="#1FFFFFFF"/>
                        <Image x:Name="StatusArt" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="9" RadiusY="9"/></Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusSub" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="PreviewBtn" Grid.Column="2" Style="{StaticResource PillButton}" Content="Show pop-up" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Pop-up -->
            <TextBlock Text="Pop-up" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show the pop-up on key presses" Style="{StaticResource Label}"/>
                            <TextBlock Text="Off: keys still work, silently." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowPopupBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Position" Style="{StaticResource Label}"/>
                        <!-- Mini screen with six spots -->
                        <Border Grid.Column="1" Width="112" Height="68" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <RadioButton x:Name="PosTL" GroupName="Pos" Style="{StaticResource PlaceTile}" VerticalAlignment="Top" HorizontalAlignment="Left" ToolTip="Top left"/>
                                <RadioButton x:Name="PosTC" GroupName="Pos" Grid.Column="1" Style="{StaticResource PlaceTile}" VerticalAlignment="Top" HorizontalAlignment="Center" ToolTip="Top center"/>
                                <RadioButton x:Name="PosTR" GroupName="Pos" Grid.Column="2" Style="{StaticResource PlaceTile}" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="Top right"/>
                                <RadioButton x:Name="PosBL" GroupName="Pos" Grid.Row="1" Style="{StaticResource PlaceTile}" VerticalAlignment="Bottom" HorizontalAlignment="Left" ToolTip="Bottom left"/>
                                <RadioButton x:Name="PosBC" GroupName="Pos" Grid.Row="1" Grid.Column="1" Style="{StaticResource PlaceTile}" VerticalAlignment="Bottom" HorizontalAlignment="Center" ToolTip="Bottom center"/>
                                <RadioButton x:Name="PosBR" GroupName="Pos" Grid.Row="1" Grid.Column="2" Style="{StaticResource PlaceTile}" VerticalAlignment="Bottom" HorizontalAlignment="Right" ToolTip="Bottom right"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Screen" Style="{StaticResource Label}"/>
                        <Border Grid.Column="1" CornerRadius="9" Background="#0DFFFFFF" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ScreenMouse" GroupName="Screen" Style="{StaticResource Segment}" Content="Where the mouse is"/>
                                <RadioButton x:Name="ScreenPrimary" GroupName="Screen" Style="{StaticResource Segment}" Content="Main screen"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Stays on screen for" Style="{StaticResource Label}"/>
                        <Slider x:Name="DurationSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Width="150" Minimum="1" Maximum="8" SmallChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DurationText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Don't show over fullscreen games and videos" Style="{StaticResource Label}"/>
                            <TextBlock Text="Keys keep working; only the pop-up is skipped." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="FullscreenBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Keys -->
            <TextBlock Text="Keys" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hold Next / Previous to scrub" Style="{StaticResource Label}"/>
                            <TextBlock Text="Speeds up the longer you hold; release to jump there. A quick tap still skips the track." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="ScrubBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hold Play/Pause to switch app" Style="{StaticResource Label}"/>
                            <TextBlock Text="Only when more than one app has media. A quick tap still plays or pauses." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="SwitchBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Double-tap Play/Pause to open the app" Style="{StaticResource Label}"/>
                            <TextBlock Text="Brings the playing app (or the browser window with the video) to the front. Playback stays as it was." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="DoubleTapBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keep media keys from Windows at all times" Style="{StaticResource Label}"/>
                            <TextBlock Text="Even with nothing open, the keys come to Tempo instead of showing the Windows flyout." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="AlwaysBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Skip buttons jump" Style="{StaticResource Label}"/>
                        <Border Grid.Column="1" CornerRadius="9" Background="#0DFFFFFF" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Skip5" GroupName="Skip" Style="{StaticResource Segment}" Content="5 s"/>
                                <RadioButton x:Name="Skip10" GroupName="Skip" Style="{StaticResource Segment}" Content="10 s"/>
                                <RadioButton x:Name="Skip15" GroupName="Skip" Style="{StaticResource Segment}" Content="15 s"/>
                                <RadioButton x:Name="Skip30" GroupName="Skip" Style="{StaticResource Segment}" Content="30 s"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Apps -->
            <TextBlock Text="Apps the keys can control" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <StackPanel x:Name="AppsList"/>
                    <TextBlock x:Name="AppsEmpty" Text="No media apps seen yet. Play something and it shows up here." Style="{StaticResource Hint}" Margin="16,14"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Let other players have the keys while they play" Style="{StaticResource Label}"/>
                            <TextBlock Text="For players that don't report to Windows (VLC 3, MPC-HC, PotPlayer, Winamp…): while one is playing, keys go to it instead." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <CheckBox x:Name="PassBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recently played -->
            <Grid Margin="4,22,0,8">
                <TextBlock Text="Recently played" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="ClearHistoryBtn" Style="{StaticResource PillButton}" Content="Clear" Padding="10,3" FontSize="11.5" HorizontalAlignment="Right"/>
            </Grid>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <StackPanel x:Name="HistoryList"/>
                    <TextBlock x:Name="HistoryEmpty" Text="Tracks you play show up here, so you can find that song again." Style="{StaticResource Hint}" Margin="16,14"/>
                </StackPanel>
            </Border>

            <!-- Stats -->
            <TextBlock Text="Stats" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource CardBox}" Padding="8,12">
                <Grid x:Name="StatsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                </Grid>
            </Border>
            <TextBlock x:Name="StatsSince" Style="{StaticResource Hint}" Margin="6,6,0,0"/>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Update automatically" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdatesBtn" Grid.Column="1" Style="{StaticResource PillButton}" Content="Check now" Margin="12,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoUpdateBox" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Quit Tempo" Style="{StaticResource Label}"/>
                            <TextBlock Text="Media keys go back to Windows until Tempo is opened again." Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="QuitBtn" Grid.Column="1" Style="{StaticResource PillButton}" Content="Quit" Foreground="#FF8A8A" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
