<Window x:Class="Tempo.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Fg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>

        <Geometry x:Key="PlayGeo">M8 5.14v13.72c0 .79.87 1.27 1.54.84l10.4-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14z</Geometry>
        <Geometry x:Key="PauseGeo">M7.5 5h2a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5h-2A1.5 1.5 0 0 1 6 17.5v-11A1.5 1.5 0 0 1 7.5 5zM14.5 5h2a1.5 1.5 0 0 1 1.5 1.5v11a1.5 1.5 0 0 1-1.5 1.5h-2a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 14.5 5z</Geometry>
        <Geometry x:Key="NextGeo">M4.5 6.2v11.6c0 .8.9 1.3 1.6.8l8.2-5.8a1 1 0 0 0 0-1.6L6.1 5.4c-.7-.5-1.6 0-1.6.8zM17 5.5h1.5a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H17a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z</Geometry>
        <Geometry x:Key="BackGeo">M12 4.5V2.2c0-.4-.5-.7-.8-.4L7.6 5.1c-.3.2-.3.6 0 .8l3.6 3.3c.3.3.8 0 .8-.4V6.5a6 6 0 1 1-6 6.2 1 1 0 0 0-2 0A8 8 0 1 0 12 4.5z</Geometry>
    </Window.Resources>

    <!-- Margin leaves room for the shadow -->
    <Grid x:Name="Root" Margin="28" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Shadow" CornerRadius="20" Background="#F2141519">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/></Border.Effect>
        </Border>

        <Grid x:Name="Card" Width="404">
            <!-- Blurred artwork backdrop -->
            <Rectangle x:Name="Backdrop" Opacity="0.6" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="1.35" ScaleY="1.6"/></Rectangle.RenderTransform>
                <Rectangle.Effect><BlurEffect Radius="56" RenderingBias="Performance" KernelType="Gaussian"/></Rectangle.Effect>
            </Rectangle>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A6111216" Offset="0"/>
                        <GradientStop Color="#E0111216" Offset="0.65"/>
                        <GradientStop Color="#F0111216" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse x:Name="Glow" Width="260" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-90,0,0" IsHitTestVisible="False"/>
            <Border CornerRadius="20" BorderBrush="#1CFFFFFF" BorderThickness="1" IsHitTestVisible="False"/>

            <Grid Margin="16,16,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Artwork + track info -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ArtBox" Width="88" Height="88" RenderTransformOrigin="0.5,0.5" Cursor="Hand" Background="Transparent">
                        <Grid.RenderTransform><ScaleTransform x:Name="ArtScale"/></Grid.RenderTransform>
                        <Border CornerRadius="12" Background="#26FFFFFF">
                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.45"/></Border.Effect>
                        </Border>
                        <Grid x:Name="ArtClip">
                            <Border x:Name="ArtPlaceholder" Background="#1F2026">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                            </Border>
                            <Image x:Name="ArtA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="ArtB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0"/>
                        </Grid>
                        <!-- Big glyph that pops over the art on a key press -->
                        <Border x:Name="ActionBadge" CornerRadius="12" Background="#73000000" Opacity="0" IsHitTestVisible="False">
                            <Viewbox Width="34" Height="34">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="ActionGlyph" Fill="White" Data="{StaticResource PlayGeo}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True" Height="22">
                            <Button x:Name="SettingsBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Opacity="0" ToolTip="Tempo settings" Margin="4,0,-4,0">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </Button>
                            <Button x:Name="CopyBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Opacity="0" ToolTip="Copy song name" Margin="4,0,0,0">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </Button>
                            <StackPanel x:Name="Sources" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel x:Name="AppLine" Orientation="Horizontal" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="AppLineShift"/></StackPanel.RenderTransform>
                                <Image x:Name="AppIcon" Width="14" Height="14" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="AppName" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                <Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Progress -->
                <Grid Grid.Row="1" Margin="0,14,0,0" x:Name="ProgressRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="0:00"/>
                    <Grid x:Name="Progress" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand" Margin="4,0">
                        <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                        <Ellipse x:Name="ProgressThumb" Width="12" Height="12" Fill="#F2F3F7" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45"/></Ellipse.Effect>
                        </Ellipse>
                        <Border x:Name="ScrubBadge" CornerRadius="6" Background="{DynamicResource Accent}" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,-34,0,0" Opacity="0" IsHitTestVisible="False">
                            <TextBlock x:Name="ScrubText" FontSize="11" FontWeight="SemiBold" Foreground="#111216"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DurText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
                </Grid>

                <!-- Controls -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" Style="{StaticResource IconButton}" ToolTip="Back 10 seconds">
                            <Grid Width="22" Height="22">
                                <Viewbox><Canvas Width="24" Height="24"><Path Fill="{StaticResource Fg}" Data="{StaticResource BackGeo}"/></Canvas></Viewbox>
                                <TextBlock x:Name="BackLabel" Text="10" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="6,0,0,0" ToolTip="Previous">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><ScaleTransform ScaleX="-1"/></Canvas.RenderTransform><Path Fill="{StaticResource Fg}" Data="{StaticResource NextGeo}"/></Canvas></Viewbox>
                        </Button>
                        <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Width="48" Height="48" Margin="8,0" Background="{DynamicResource Accent}" ToolTip="Play / pause">
                            <Grid>
                                <Ellipse x:Name="PlayRing" Width="48" Height="48" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PlayRingScale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path x:Name="PlayGlyph" Fill="#111216" Data="{StaticResource PlayGeo}"/></Canvas></Viewbox>
                            </Grid>
                        </Button>
                        <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,0,6,0" ToolTip="Next">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Fill="{StaticResource Fg}" Data="{StaticResource NextGeo}"/></Canvas></Viewbox>
                        </Button>
                        <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" ToolTip="Forward 10 seconds">
                            <Grid Width="22" Height="22">
                                <Viewbox><Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><ScaleTransform ScaleX="-1"/></Canvas.RenderTransform><Path Fill="{StaticResource Fg}" Data="{StaticResource BackGeo}"/></Canvas></Viewbox>
                                <TextBlock x:Name="FwdLabel" Text="10" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="VolumeBox" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Mute this app">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource Muted}" Data="M3.5 9.2h3.3l4.3-3.6c.6-.5 1.4-.1 1.4.7v11.4c0 .8-.8 1.2-1.4.7l-4.3-3.6H3.5a1 1 0 0 1-1-1V10.2a1 1 0 0 1 1-1z"/>
                                    <Path x:Name="VolWaves" Stroke="{StaticResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15.6 9.1a4.2 4.2 0 0 1 0 5.8M18.4 6.4a8 8 0 0 1 0 11.2"/>
                                    <Path x:Name="VolMuteX" Stroke="{StaticResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15.5 9.5l5 5M20.5 9.5l-5 5" Visibility="Collapsed"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Slider x:Name="VolSlider" Style="{StaticResource ThinSlider}" Width="44" Minimum="0" Maximum="100" Margin="2,0,0,0" ToolTip="App volume (or scroll anywhere on the card)"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right-click menu -->
            <Border x:Name="MenuShade" Background="#59000000" Visibility="Collapsed"/>
            <Border x:Name="Menu" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                    CornerRadius="10" Background="#F51C1D23" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="4">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5"/></Border.Effect>
                <StackPanel x:Name="MenuItems" MinWidth="200"/>
            </Border>
        </Grid>
    </Grid>
</Window>
